<Project>
	<PropertyGroup>
		<!-- Enable NuGet Central Package Management -->
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>
	<ItemGroup>
		<!-- Logging abstractions per target framework (explicit versions are required for CPM) -->
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" Condition=" '$(TargetFramework)' != 'net9.0' " />
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" Condition=" '$(TargetFramework)' == 'net9.0' " />

		<!-- Test and coverage packages (explicit versions) -->
		<PackageVersion Include="coverlet.collector" Version="10.1.0" />
		<PackageVersion Include="coverlet.msbuild" Version="10.1.0" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
		<PackageVersion Include="NSubstitute" Version="6.2.0" />
		<PackageVersion Include="xunit.v3" Version="4.0.3" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
	</ItemGroup>
</Project>